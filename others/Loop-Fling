	local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
	local troot = thum and thum.RootPart
	if troot and troot.CollisionGroup == "NoClip" then
		return true
	end
	return false
end

local function flingtarget(target)
	local char = localplayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = hum and hum.RootPart
	local tchar = target.Character
	local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
	local thead = tchar and tchar:FindFirstChild("Head")

	if not (char and hum and root and tchar and thum) then return end
	if not tchar:FindFirstChildWhichIsA("BasePart") then return end
	if isprotected(target) then return end

	local hitpart = thead or thum.RootPart
	if not hitpart then return end

	if root.Velocity.Magnitude < 50 then
		getgenv().oldpos = root.CFrame
	end

	local att1 = Instance.new("Attachment", root)
	local att2 = Instance.new("Attachment", hitpart)

	local starttime = tick()
	local waittime = 0.134

	repeat
		if not flingon then break end
		root.CFrame = CFrame.new(hitpart.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.random(0,1) * math.pi, math.random(0,1) * math.pi, math.random(0,1) * math.pi)
		root.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
		task.wait()
	until hitpart.Velocity.Magnitude > 1000
		or hitpart.Parent ~= tchar
		or target.Parent ~= players
		or hum.Health <= 0
		or tick() > starttime + waittime

	att1:Destroy()
	att2:Destroy()

	if root and getgenv().oldpos then
		root.CFrame = getgenv().oldpos * CFrame.new(0, 0.5, 0)
